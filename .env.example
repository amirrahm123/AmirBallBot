ANTHROPIC_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
# Optional: override the Gemini model used by routes/verify.ts only.
# Defaults to GEMINI_MODEL if unset, then to 'gemini-2.5-flash' if neither is set.
# Use this when you want verify to run on a cheaper text-only model than the main analyzer.
GEMINI_VERIFY_MODEL=
